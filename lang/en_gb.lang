# Settings
trash_settings = Settings
trash_settings_title = Settings
trash_settings_saved = Settings saved.
trash_settings_quick_undo = Offer instant undo
trash_settings_quick_undo_notice = Shows a notice with an undo link right after deleting. Articles and categories are in the trash anyway; individual blocks are buffered for the duration of the time limit.
trash_settings_timeout = Time limit in seconds
trash_settings_timeout_notice = How long the notice stays visible (5–300). Affects only the instant notice, not the trash itself.
trash_settings_history_ok = History plugin active – deleted blocks can also be restored later from the article history.
trash_settings_history_missing = Without the structure/history plugin, individually deleted blocks are not stored anywhere, so no undo notice is shown for them. Articles and categories are unaffected – those are covered by the trash.
trash_settings_save = Save settings
